block(`schema) {

  export(`{

    /**
     * A job with a unique id.
     */
    Job(job), Job_id(job:id) -> int128(id).

    /**
     * An account is a group of users with a unique id.
     */
    Account(account), Account_id(account:id) -> string(id).

    /**
     * A job implementation has a unique id within an account. The code
     * is a concatenation of the account + "-" = id.
     */
    JobImpl(impl), JobImpl_code(impl:id) -> string(id).

    /**
     * The account a user belongs to.
     */
    User_account[u] = a -> system:app:User(u), Account(a).

    /**
     * Whether a version is a supported platform version
     */
    supported_platform_version(p) -> string(p).
  })

} <-- .

