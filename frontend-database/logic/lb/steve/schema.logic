block(`schema) {

  export(`{

    /**
     * A job with a unique id.
     */
    Job(job), Job_id(job:id) -> string(id).

    /**
     * An account is a group of users with a unique id.
     */
    Account(account), Account_id(account:id) -> string(id).

    /**
     * A job implementation has a unique id within an account.
     */
    JobImpl(impl), JobImp_id(impl:id) -> string(id).

    /**
     * A constructor for job implementations.
     */
    impl[account, id] = impl -> Account(account), string(id), JobImpl(impl).

    /**
     * The account a user belongs to.
     */
    User_account[u] = a -> system:app:User(u), Account(a).

  })

} <-- .

