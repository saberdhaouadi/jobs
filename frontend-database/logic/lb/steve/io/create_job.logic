block(`create_job) {

  alias(`lb:steve:database, `proto),

  clauses(`{

    /**
     * Validate the user.
     */
    +service_support:ensure_user(index, userId) <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_user_id[req] = userId.

    /**
     * Validate the impl id.
     */
    +service_support:ensure_impl(index, userId, jobImplId) <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_user_id[req] = userId,
      +proto:CreateJobRequest_impl_id[req] = jobImplId.


    /**
     * Check if job exists.
     */
    create_new_job(req) -> proto:CreateJobRequest(req).
    lang:pulse(`create_new_job).

    // job with this client id already exists, export success
    +service_support:export_job_id(index, jobId) <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_client_id[req] = clientId,
      schema:Job:by_client_id@prev[clientId] = jobId.

    // job needs to be created
    +create_new_job(req) <-
      +proto:CreateJobRequest_client_id[req] = clientId,
      // No previous request with this clientId should exist
      !schema:Job:by_client_id@prev[clientId] = _,
      // If an error is reported, do not create job.
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      ! +service_support:export_error(index,_,_).
     


    /**
     * Construct new job and export success.
     */
    +service_support:export_job_id(index, id),
    +schema:Job(j),
    +schema:Job_id[j] = id,
    +schema:Job:impl[j] = impl,
    +schema:Job:client_id[j] = clientId,
    +schema:Job:output_prefix[j] = prefix, 
    +schema:Job:user[j] = user <-
      +create_new_job(req),
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_job_id[req] = id,
      +proto:CreateJobRequest_client_id[req] = clientId,
      +proto:CreateJobRequest_impl_id[req] = implId,
      +proto:CreateJobRequest_output_prefix[req] = prefix,
      +proto:CreateJobRequest_user_id[req] = userId,
      system:app:User:name@prev(user:userId),
      schema:User_account@prev[user] = account,
      schema:JobImpl:id@prev[impl] = implId,
      schema:JobImpl:account@prev[impl] = account.

    // wire input
    +schema:Job:input(job, url) <-
      +create_new_job(req),
      +proto:CreateJobRequest_job_id[req] = id,
      +schema:Job_id[job] = id,
      +proto:CreateJobRequest_input(req, f), 
      +proto:File_url[f] = url.

    +schema:Job:input_hash[job, url] = hash <-
      +create_new_job(req),
      +proto:CreateJobRequest_job_id[req] = id,
      +schema:Job_id[job] = id,
      +proto:CreateJobRequest_input(req, f),
      +proto:File_url[f] = url,
      +proto:File_hash[f] = hash.

    // wire metadata
    +schema:Job:metadata[job, key] = value <-
      +create_new_job(req),
      +proto:CreateJobRequest_job_id[req] = id,
      +schema:Job_id[job] = id,
      +proto:CreateJobRequest_metadata(req, p), 
      +proto:Param_key[p] = key,
      +proto:Param_value[p] = value.    

    // wire output encryption key
    +schema:Job:output_encryption_key[job] = key <-
      +create_new_job(req),
      +proto:CreateJobRequest_job_id[req] = id,
      +schema:Job_id[job] = id,
      +proto:CreateJobRequest_output_encryption_key[req] = key.

    // Check if platform version is available.
    platform_version(p) -> string(p).
    platform_version(p) <-
      p = "3.10.15"
    ; p = "4.1.5"
    ; p = "4.1.6"
    ; p = "4.1.7"
    ; p = "4.1.8"
    ; p = "4.1.9"
    ; p = "4.2.0"
    ; p = "4.2.1"
    ; p = "4.3.0".

    +service_support:export_error(index, "INVALID_INPUT", "Input '" + url + "' is invalid. Should be a S3 URL.") <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_input(req, f),
      +proto:File_url[f] = url,
      ! string:like(url, "s3://%").

    +service_support:export_error(index, "INVALID_OUTPUT", "Output '" + prefix + "' is invalid. Should be a S3 URL.") <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_output_prefix[req] = prefix,
      ! string:like(prefix, "s3://%"),
      prefix != "".

    +service_support:export_error(index, "INVALID_PLATFORM", "Platform '" + platformId + "' not supported.") <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_metadata(req, p),
      +proto:Param_key[p] = "platform",
      +proto:Param_value[p] = platformId,
      !platform_version(platformId).

    // Check no-services value
    +service_support:export_error(index, "INVALID_METADATA", "Value of 'no-services' can only be 'true'.") <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_metadata(req, p),
      +proto:Param_key[p] = "no-services",
      +proto:Param_value[p] != "true".

    // Check timeout value
    +service_support:export_error(index, "INVALID_TIMEOUT", "Timeout should be between 0 and 40000 seconds.") <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_create_job[union] = req,
      +proto:CreateJobRequest_metadata(req, qp),
      +proto:Param_key[qp] = "job-queue",
      +proto:Param_value[qp] = q,
      +proto:CreateJobRequest_metadata(req, p),
      +proto:Param_key[p] = "timeout",
      +proto:Param_value[p] = t,
      string:int:convert[t] = timeout,
      (timeout < 0 ; timeout > 40000),
      // For Walgreens, we allow timeouts > 40000s for the time being.
      q != "i2-2xlarge".
  })

} <-- .
