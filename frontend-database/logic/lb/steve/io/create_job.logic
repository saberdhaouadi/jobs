block(`create_job) {

  alias(`lb:steve:database, `proto),

  inactive(),

  clauses(`{

    /**
     * Validate the user.
     */
    +service_support:ensure_user(index, userId) <-
      +proto:RequestEnvelope_create_job[_, index] = req,
      +proto:CreateJobRequest_user_id[req] = userId.

    /**
     * Validate the impl id.
     */
    +service_support:ensure_impl(index, userId, jobImplId) <-
      +proto:RequestEnvelope_create_job[_, index] = req,
      +proto:CreateJobRequest_user_id[req] = userId,
      proto:CreateJobRequest_impl_id[req] = jobImplId.


    /**
     * Check if job exists.
     */
    create_new_job(req) -> proto:CreateJobRequest(req).

    // job with this client id already exists, export success
    +service_support:export_job_id(index, jobId) <-
      +proto:RequestEnvelope_create_job[_, index] = req,
      +proto:CreateJobRequest_client_id[req] = clientId,
      schema:Job:by_client_id@prev[clientId] = jobId.

    // job needs to be created
    +create_new_job(req) <-
      +proto:CreateJobRequest_client_id[req] = clientId,
      !schema:Job:by_client_id@prev[clientId] = _.
    
    /**
     * Construct new job and export success.
     */
    +service_support:export_job_id(index, id),
    +schema:Job(j),
    +schema:Job_id[j] = id,
    +schema:Job:impl[j] = impl,
    +schema:Job:client_id[j] = clientId,
    +schema:Job:output_prefix[j] = prefix, 
    +schema:Job:user[j] = user <-
      +create_new_job(req),
      +proto:RequestEnvelope_create_job[_, index] = req,
      +proto:CreateJobRequest_job_id[req] = id,
      +proto:CreateJobRequest_client_id[req] = clientId,
      +proto:CreateJobRequest_impl_id[req] = implId,
      +proto:CreateJobRequest_output_prefix[req] = prefix,
      +proto:CreateJobRequest_user_id[req] = userId,
      system:app:User:name(user:userId),
      schema:User_account[user] = account,
      schema:impl[account, implId] = impl.

    // wire input
    +schema:Job:input(job, url) <-
      +create_new_job(req),
      +proto:CreateJobRequest_job_id[req] = id,
      +schema:Job_id[job] = id,
      +proto:CreateJobRequest_input(req, f), 
      +proto:File_url[f] = url.

    +schema:Job:input_hash[job, url] = hash <-
      +create_new_job(req),
      +proto:CreateJobRequest_job_id[req] = id,
      +schema:Job_id[job] = id,
      +proto:CreateJobRequest_input(req, f),
      +proto:File_url[f] = url,
      +proto:File_hash[f] = hash.

    // wire metadata
    +schema:Job:metadata[job, key] = value <-
      +create_new_job(req),
      +proto:CreateJobRequest_job_id[req] = id,
      +schema:Job_id[job] = id,
      +proto:CreateJobRequest_metadata(req, p), 
      +proto:Param_key[p] = key,
      +proto:Param_value[p] = value.    
  })

} <-- .