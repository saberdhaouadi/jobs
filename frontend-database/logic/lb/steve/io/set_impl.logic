block(`set_impl) {

  alias(`lb:steve:database, `proto),

  clauses(`{
   
    /**
     * Validate the user.
     */
    +service_support:ensure_user(index, userId) <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_set_impl[union] = req,
      +proto:SetJobImplRequest_user_id[req] = userId.


    // to correlate the index to the impl object created for it
    impl_by_index[index] = impl -> int(index), schema:JobImpl(impl).
    lang:pulse(`impl_by_index).

    /**
     * Set impl details and export success.
     */
    +service_support:export_success(index),
    +schema:JobImpl(impl),
    +schema:JobImpl_code[impl] = accountId + "-" + implId,
    +schema:JobImpl:id[impl] = implId,
    +impl_by_index[index] = impl,
    +schema:JobImpl(impl),
    ^schema:JobImpl:user[impl] = user,
    ^schema:JobImpl:archive[impl] = url <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_set_impl[union] = req,
      +proto:SetJobImplRequest_user_id[req] = userId,
      +proto:SetJobImplRequest_impl_id[req] = implId,
      +proto:SetJobImplRequest_file[req] = fileProto,
      +proto:File_url[fileProto] = url,
      system:app:User:name(user:userId),
      schema:User_account[user] = account,
      schema:Account_id(account:accountId).

    // Hash is optional, so it needs a separate rule.
    ^schema:JobImpl:archive_hash[impl] = hash <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_set_impl[union] = req,
      +service_support:export_success(index),
      +impl_by_index[index] = impl,
      +proto:SetJobImplRequest_file[req] = fileProto,
      +proto:File_hash[fileProto] = hash.

    // wire metadata
    ^schema:JobImpl:metadata[impl, key] = value <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_set_impl[union] = req,
      +service_support:export_success(index),
      +impl_by_index[index] = impl,
      +proto:SetJobImplRequest_metadata(req, p),
      +proto:Param_key[p] = key,
      +proto:Param_value[p] = value.

    // cleanup old metadata if it's not updated
    -schema:JobImpl:metadata[impl, key] = value <-
      +proto:RequestEnvelope_request[_, index] = union,
      +proto:Request_set_impl[union] = _,
      +service_support:export_success(index),
      +impl_by_index[index] = impl,
      schema:JobImpl:metadata@prev[impl, key] = value,
      !+schema:JobImpl:metadata[impl, key] = value.
  })

} <-- .
