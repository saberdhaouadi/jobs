block(`service_support) {

  alias(`lb:steve:database, `proto),
  
  export(`{

    // constructors (used by pulse helpers)

    /**
     * Constructor for the response envelope.
     */
    envelope[req] = resp -> proto:RequestEnvelope(req), proto:ResponseEnvelope(resp).

    /**
     * Constructor for the response message in this index. This response contains
     * one of the possible outcomes below.
     */
    response[index] = resp -> int(index), proto:Response(resp).

    /**
     * Constructor for a Job message in this index (encapsulated by the response in the same index).
     */
    job[index, jobId] = job -> int(index), int128(jobId), proto:Job(job).

    /**
     * Constructor for a JobImpl message in this index (encapsulated by the response in the same index).
     * Note that an index contains a set of jobimpl messages, so we key by schema:JobImpl_code too.
     */
    impl[index, implCode] = proto -> int(index), string(implCode), proto:JobImpl(proto).

    /**
     * Constructor for an Error message in this index (encapsulated by the response in the same index).
     */
    error[index] = error -> int(index), proto:Error(error).

    // pulse helpers

    /**
     * Export a job in the response with this index.
     */
    export_job(index, jobId) -> int(index), int128(jobId).

    /**
     * Export a jobImpl in the response with this index.
     */
    export_impl(index, implCode) -> int(index), string(implCode).

    /**
     * Export a queue in the response with this index.
     */
    export_queue(index, queue) -> int(index), string(queue).

    /**
     * Export a platform in the response with this index.
     */
    export_platform(index, platform) -> int(index), string(platform).

    /**
     * Export a metadata key in the response with this index.
     */
    export_metadata_key(index, key) -> int(index), string(key).

    /**
     * Export a metadata value in the response with this index.
     */
    export_metadata_value(index, value) -> int(index), string(value).

    /**
     * Export an error with this content in the response with this index.
     */
    export_error(index, code, message) -> int(index), string(code), string(message).

    /**
     * If a user with this id does not exist, generate an error in this index.
     */
    ensure_user(index, userId) -> int(index), string(userId).

    /**
     * If a job with this id does not exist, generate an error in this index.
     */
    ensure_job(index, jobId) -> int(index), int128(jobId).

    /**
     * If a job impl with this id does not exist, or if it does not belong to this user,
     * generate an error in this index.
     */
    ensure_impl(index, userId, jobImplId) -> int(index), string(userId), string(jobImplId).

  }),

  clauses(`{

    lang:constructor(`envelope).
    lang:pulse(`envelope).

    lang:constructor(`job).
    lang:pulse(`job).
    lang:constructor(`impl).
    lang:pulse(`impl).
    lang:constructor(`error).
    lang:pulse(`error).

    lang:constructor(`response).
    lang:pulse(`response).

    lang:pulse(`export_error).
    lang:pulse(`export_job).
    lang:pulse(`export_impl).
    lang:pulse(`export_platform).
    lang:pulse(`export_queue).
    lang:pulse(`export_metadata_key).
    lang:pulse(`export_metadata_value).

    lang:pulse(`ensure_user).
    lang:pulse(`ensure_job).
    lang:pulse(`ensure_impl).

    // always construct an envelope
    +proto:ResponseEnvelope(resp),
    +envelope[req] = resp <-
      +proto:RequestEnvelope(req).

    // always construct a response for each request
    +response[index] = resp,
    +proto:Response(resp),
    +proto:ResponseEnvelope_response[env, index] = resp <-
      +envelope[_] = env,
      +proto:RequestEnvelope_request[_, index] = _.


    // ERROR: add an error to the response
    +error[i] = error,
    +proto:Error(error),
    +proto:Error_code[error] = code,
    +proto:Error_message[error] = message,
    +proto:Response_error[resp] = error <-
      +export_error(i, code, message),
      +response[i] = resp.
    

    // JOB: add a job to the response
    +job[i, jobId] = protoJob,
    +proto:Job(protoJob),
    +proto:Job_id[protoJob] = int128:to_uuid_string[jobId],
    +proto:Response_job[resp] = protoJob <-
      +response[i] = resp,
      +export_job(i, jobId),
      schema:Job_id[_] = jobId.


    // JOB IMPL: add a job impl to the response
    +impl[i, implCode] = protoJobImpl,
    +proto:JobImpl(protoJobImpl),
    +proto:JobImpl_id[protoJobImpl] = implId,
    +proto:Response_impl(resp, protoJobImpl) <-
      +response[i] = resp,
      +export_impl(i, implCode),
      schema:JobImpl_code@prev[impl] = implCode,
      schema:JobImpl:id@prev[impl] = implId.

    // QUEUE: add queue to response
    +proto:Response_queue(resp, queue) <-
      +response[i] = resp,
      +export_queue(i,queue).

    // PLATFORM: add platform to response
    +proto:Response_platform(resp, platform) <-
      +response[i] = resp,
      +export_platform(i, platform).

    // METADATA KEY: add metadata key to response
    +proto:Response_metadata_key(resp, key) <-
      +response[i] = resp,
      +export_metadata_key(i, key).

    // METADATA VALUE: add metadata value to response
    +proto:Response_metadata_value(resp, value) <-
      +response[i] = resp,
      +export_metadata_value(i, value).

    // error checking rules
    +export_error(index, "NO_SUCH_USER", "User '" + userId + "' does not exist.") <-
      +ensure_user(index, userId),
      ! system:app:User:name(_:userId).

    +export_error(index, "NO_SUCH_JOB", "Job '" + int128:to_uuid_string[jobId] + "' does not exist.") <-
      +ensure_job(index, jobId),
      !schema:Job_id@prev[_] = jobId.

    +export_error(index, "NO_SUCH_JOB_IMPL", "Job implementation '" + jobImplId + "' does not exist in account '" + accountId + "'.") <-
      +ensure_impl(index, userId, jobImplId),
      system:app:User:name(user:userId),
      schema:User_account@prev[user] = account,
      schema:Account_id[account] = accountId,
      code = accountId + "-" + jobImplId,
      !schema:JobImpl_code[_] = code.

  })

} <-- .
