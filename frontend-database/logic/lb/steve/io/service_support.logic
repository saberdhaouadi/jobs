block(`service_support) {

  alias(`lb:steve:database, `proto),
  
  export(`{

    // constructors (used by pulse helpers)

    /**
     * Constructor for the response envelope.
     */
    envelope[req] = resp -> proto:RequestEnvelope(req), proto:ResponseEnvelope(resp).

    /**
     * Constructor for the response message in this index. This response contains
     * one of the possible outcomes below.
     */
    response[index] = resp -> int(index), proto:Response(resp).

    /**
     * Constructor for a Job message in this index (encapsulated by the response in the same index).
     */
    job[index] = job -> int(index), proto:Job(job).

    /**
     * Constructor for a JobImpl message in this index (encapsulated by the response in the same index).
     * Note that an index contains a set of jobimpl messages, so we key by schema:JobImpl too.
     */
    impl[index, impl] = proto -> int(index), schema:JobImpl(impl), proto:JobImpl(proto).

    /**
     * Constructor for an Error message in this index (encapsulated by the response in the same index).
     */
    error[index] = error -> int(index), proto:Error(error).

    // pulse helpers

    /**
     * Export an empty Response, which indicates success.
     */
    export_success(index) -> int(index).

    /**
     * Export a job id in the response with this index.
     */
    export_job_id(index, jobId) -> int(index), string(jobId).

    /**
     * Export a job in the response with this index.
     */
    export_job(index, job) -> int(index), schema:Job(job).

    /**
     * Export a jobImpl in the response with this index.
     */
    export_impl(index, impl) -> int(index), schema:JobImpl(impl).

    /**
     * Export an error with this content in the response with this index.
     */
    export_error(index, code, message) -> int(index), string(code), string(message).

    /**
     * If a user with this id does not exist, generate an error in this index.
     */
    ensure_user(index, userId) -> int(index), string(userId).

    /**
     * If a job with this id does not exist, generate an error in this index.
     */
    ensure_job(index, jobId) -> int(index), string(jobId).

    /**
     * If a job impl with this id does not exist, or if it does not belong to this user,
     * generate an error in this index.
     */
    ensure_impl(index, userId, jobImplId) -> int(index), string(userId), string(jobImplId).

  }),

  clauses(`{

    lang:constructor(`envelope).
    lang:pulse(`envelope).

    lang:constructor(`job).
    lang:pulse(`job).
    lang:constructor(`impl).
    lang:pulse(`impl).
    lang:constructor(`error).
    lang:pulse(`error).

    lang:constructor(`response).
    lang:pulse(`response).

    lang:pulse(`export_error).
    lang:pulse(`export_success).
    lang:pulse(`export_job_id).
    lang:pulse(`export_job).
    lang:pulse(`export_impl).

    lang:pulse(`ensure_user).
    lang:pulse(`ensure_job).
    lang:pulse(`ensure_impl).

    // always construct an envelope for the response
    +proto:ResponseEnvelope(resp),
    +envelope[req] = resp <-
      +proto:RequestEnvelope(req).


    // ERROR: create a response, an error, and wire
    +response[i] = resp,
    +proto:Response(resp),    
    +error[i] = error,
    +proto:Error(error),
    +proto:Error_code[error] = code,
    +proto:Error_message[error] = message,
    +proto:ResponseEnvelope_response[env, i] = resp,
    +proto:Response_error[resp] = error <-
      +envelope[_] = env,
      +export_error(i, code, message).


    // SUCCESS: create an empty response, and wire
    +response[i] = resp,
    +proto:Response(resp),
    +proto:ResponseEnvelope_response[env, i] = resp <-
      +envelope[_] = env,
      +export_success(i).


    // JOB ID: create a response, a job id, and wire
    +response[i] = resp,
    +proto:Response(resp),
    +proto:ResponseEnvelope_response[env, i] = resp,
    +proto:Response_job_id[resp] = id <-
      +envelope[_] = env,
      +export_job_id(i, id).


    // JOB: create a response, a job, and wire
    +response[i] = resp,
    +proto:Response(resp),    
    +job[i] = protoJob,
    +proto:Job(protoJob),
    +proto:Job_id[protoJob] = id,
    +proto:ResponseEnvelope_response[env, i] = resp,
    +proto:Response_job[resp] = protoJob <-
      +envelope[_] = env,
      +export_job(i, job),
      schema:Job_id[job] = id.


    // JOB IMPL: create a response, a job impl, and wire
    +response[i] = resp,
    +proto:Response(resp),
    +impl[i, impl] = protoJobImpl,
    +proto:JobImpl(protoJobImpl),
    +proto:JobImpl_id[protoJobImpl] = id,
    +proto:ResponseEnvelope_response[env, i] = resp,
    +proto:Response_impl(resp, protoJobImpl) <-
      +envelope[_] = env,      
      +export_impl(i, impl),
      schema:JobImpl:id[impl] = id.



    // error checking rules
    +export_error(index, "NO_SUCH_USER", "User '" + userId + "' does not exist.") <-
      +ensure_user(index, userId),
      ! system:app:User:name(_:userId).

    +export_error(index, "NO_SUCH_JOB", "Job '" + jobId + "' does not exist.") <-
      +ensure_job(index, jobId),
      !schema:Job_id@prev[_] = jobId.

    +export_error(index, "NO_SUCH_JOB_IMPL", "Job implementation '" + jobImplId + "' does not exist in account '" + accountId + "'.") <-
      +ensure_impl(index, userId, jobImplId),
      system:app:User:name(user:userId),
      schema:User_account[user] = account,
      schema:Account_id(account:accountId),
      !schema:impl[account, jobImplId] = _.

  })

} <-- .