block(`metrics) {

  alias(`lb:steve:database, `proto),

  clauses(`{
    lang:constructor(`cons).
    lang:pulse(`cons).
    cons[req] = resp -> proto:GetMetricsRequest(req), proto:GetMetricsResponse(resp).

    lang:constructor(`cons_metric).
    lang:pulse(`cons_metric).
    cons_metric[k] = m -> string(k), proto:Metric(m).

    lang:pulse(`ensure_int_metric).
    ensure_int_metric[k] = v -> string(k), int(v).

    // Create response
    +cons[req] = resp,
    +proto:GetMetricsResponse(resp)
      <-
      +proto:GetMetricsRequest(req).

    +proto:GetMetricsResponse_metrics(resp, m),
    +cons_metric[k] = m,
    +proto:Metric(m) {
      +proto:Metric_key[] = k,
      +proto:Metric_int_value[] = v
    }
      <- +ensure_int_metric[k] = v, +cons[_] = resp.

    // TOTAL
    +ensure_int_metric["lb.steve.total"] = 0
      <- !schema:Job(_), +cons[_] = _.

    +ensure_int_metric["lb.steve.total"] = t
      <-
      agg<<t = count()>> schema:Job(_),
      +cons[_] = _.

    // RUNNING
    +ensure_int_metric["lb.steve.running"] = 0
      <- !schema:Job:running(_), +cons[_] = _.

    +ensure_int_metric["lb.steve.running"] = r
      <-
      agg<<r = count()>> schema:Job(j), schema:Job:running(j),
      +cons[_] = _.

    // QUEUED
    +ensure_int_metric["lb.steve.queued"] = 0
      <- !schema:Job:queued(_), +cons[_] = _.

    +ensure_int_metric["lb.steve.queued"] = q
      <-
      agg<<q = count()>> schema:Job(j), schema:Job:queued(j),
      +cons[_] = _.

     // TOTAL IMPL
    +ensure_int_metric["lb.steve.impl.total"] = 0
      <- !schema:Job(_), +cons[_] = _.

    +ensure_int_metric["lb.steve.impl.total"] = t
      <-
      agg<<t = count()>> schema:JobImpl(_),
      +cons[_] = _.

    // TOTAL DURATION
    +ensure_int_metric["lb.steve.duration.total"] = n
      <-
      agg<<n = total(d)>> schema:Job:duration[_]=d,
      +cons[_] = _.
})

} <-- .
