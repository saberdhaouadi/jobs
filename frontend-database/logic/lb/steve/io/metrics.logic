block(`metrics) {

  alias(`lb:steve:database, `proto),

  clauses(`{
    lang:constructor(`cons).
    lang:pulse(`cons).
    cons[req] = resp -> proto:GetMetricsRequest(req), proto:GetMetricsResponse(resp).

    lang:constructor(`cons_metric).
    lang:pulse(`cons_metric).
    cons_metric[k] = m -> string(k), proto:Metric(m).

    lang:pulse(`ensure_int_metric).
    ensure_int_metric[k] = v -> string(k), int(v).

    running_queue(q) -> string(q).
    running_queue(q) <- schema:Job:running(j), lb:steve:schema:Job:metadata[j, "job-queue"]=q.
    queued_queue(q) -> string(q).
    queued_queue(q) <- schema:Job:queued(j), lb:steve:schema:Job:metadata[j, "job-queue"]=q.

    // Create response
    +cons[req] = resp,
    +proto:GetMetricsResponse(resp)
      <-
      +proto:GetMetricsRequest(req).

    +proto:GetMetricsResponse_metrics(resp, m),
    +cons_metric[k] = m,
    +proto:Metric(m) {
      +proto:Metric_key[] = k,
      +proto:Metric_int_value[] = v
    }
      <- +ensure_int_metric[k] = v, +cons[_] = resp.

    // RUNNING PER QUEUE
    +ensure_int_metric[key] = 0
      <- !running_queue(q), +cons[_] = _,
         lb:steve:provision:jobqueue_id[_]=q,
         key="lb.steve.running."+q.

    +ensure_int_metric[key] = r
      <-
      agg<<r = count()>> schema:Job(j), schema:Job:running(j),
      +cons[_] = _,
      lb:steve:schema:Job:metadata[j, "job-queue"]=q,
      key="lb.steve.running."+q.

    // RUNNING TOTAL
    +ensure_int_metric[key] = 0
      <- !lb:steve:schema:Job:running(_), +cons[_] = _,
         key="lb.steve.running.total".

    +ensure_int_metric[key] = r
      <-
      agg<<r = count()>> schema:Job:running(_),
      +cons[_] = _,
      key="lb.steve.running.total".

    // QUEUED PER QUEUE
    +ensure_int_metric[key] = 0
      <- !queued_queue(q), +cons[_] = _,
         lb:steve:provision:jobqueue_id[_]=q,
         key="lb.steve.queued."+q.

    +ensure_int_metric[key] = n
      <-
      agg<<n = count()>> schema:Job(j), schema:Job:queued(j),
      +cons[_] = _,
      lb:steve:schema:Job:metadata[j, "job-queue"]=q,
      key="lb.steve.queued."+q.

    // QUEUED TOTAL
    +ensure_int_metric[key] = 0
      <- !lb:steve:schema:Job:running(_), +cons[_] = _,
         key="lb.steve.queued.total".

    +ensure_int_metric[key] = r
      <-
      agg<<r = count()>> schema:Job:running(_),
      +cons[_] = _,
      key="lb.steve.queued.total".

     // TOTAL IMPL
    +ensure_int_metric["lb.steve.impl.total"] = 0
      <- !schema:Job(_), +cons[_] = _.

    +ensure_int_metric["lb.steve.impl.total"] = t
      <-
      agg<<t = count()>> schema:JobImpl(_),
      +cons[_] = _.

    // LONGEST QUEUED
    +ensure_int_metric[key] = 0
      <- !queued_queue(q), +cons[_] = _,
         lb:steve:provision:jobqueue_id[_]=q,
         key="lb.steve.queued_time."+q+".max".

    +ensure_int_metric[key] = n
      <-
      agg<<n = max(w)>> schema:Job(j), schema:Job:queued(j),
      +cons[_] = _,
      lb:steve:schema:Job:metadata[j, "job-queue"]=q,
      key="lb.steve.queued_time."+q+".max",
      w=datetime:offset[lb:steve:schema:Job:created[j],datetime:now[],"seconds"].

    // SHORTEST QUEUED
    +ensure_int_metric[key] = 0
      <- !queued_queue(q), +cons[_] = _,
         lb:steve:provision:jobqueue_id[_]=q,
         key="lb.steve.queued_time."+q+".min".

    +ensure_int_metric[key] = n
      <-
      agg<<n = min(w)>> schema:Job(j), schema:Job:queued(j),
      +cons[_] = _,
      lb:steve:schema:Job:metadata[j, "job-queue"]=q,
      key="lb.steve.queued_time."+q+".min",
      w=datetime:offset[lb:steve:schema:Job:created[j],datetime:now[],"seconds"].

})

} <-- .
