block(`service_config) {

  alias_all(`lb:web:config:service),
  alias_all(`lb:web:config:service_abbr),
  alias_all(`lb:web:config:protobuf),
  alias_all(`lb:web:config:protobuf_abbr),

  clauses(`{

    // services (write)
    write_service(s) -> string(s).
    // backwards compatibility
    write_service("/db").
    write_service("/db/createJob").
    write_service("/db/addStatus").
    write_service("/db/setResult").
    write_service("/db/setJobImpl").

    // readonly services
    readonly_service(s) -> string(s).
    readonly_service("/db/getUser").
    readonly_service("/db/getJob").
    readonly_service("/db/getJobImpl").

    // declare service
    service_by_prefix[s] = x,
    default_protobuf_service(x) {
      protobuf_protocol[] = "lb:steve:database",
      protobuf_request_message[] = "RequestEnvelope",
      protobuf_response_message[] = "ResponseEnvelope",
      service_parameter["enable_http_control"] = "false"
    } <- write_service(s).

    // declare readonly service
    service_by_prefix[s] = x,
    default_protobuf_service(x) {
      readonly(),
      protobuf_protocol[] = "lb:steve:database",
      protobuf_request_message[] = "RequestEnvelope",
      protobuf_response_message[] = "ResponseEnvelope",
      service_parameter["enable_http_control"] = "false"
    } <- readonly_service(s).

  service_by_group["/metrics", "lb:web:internal"] = x,
    default_protobuf_service(x) {
      readonly(),
      protobuf_protocol[] = "lb:steve:database",
      protobuf_request_message[] = "GetMetricsRequest",
      protobuf_response_message[] = "GetMetricsResponse"
    }.

  })  

} <-- .
