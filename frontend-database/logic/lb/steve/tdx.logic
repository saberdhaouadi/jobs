block(`tdx) {
  alias_all(`lb:web:delim:schema),
  alias_all(`lb:web:delim:schema_abbr),

  alias_all(`lb:web:delim:binding),
  alias_all(`lb:web:delim:binding_abbr),

  alias_all(`lb:web:config:service),
  alias_all(`lb:web:config:service_abbr),
  alias_all(`lb:web:config:delim),

  clauses(`{
    service_by_prefix["/tdx/txn/*"] = x,
    delim_txn_service(x).

    file_definition_by_name["users"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "USER,   ACCOUNT, PUBLIC_KEY",
      column_formats[] = "string, string,  string"
    }.

    file_binding_by_name["users"] = fb,
    file_binding(fb) {
      file_binding_definition_name[] = "users",
      file_binding_entity_creation[] = "accumulate",

      predicate_binding_by_name["system:app:User:accountEnabled"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "USER"
        },
        
      predicate_binding_by_name["lb:steve:schema:User_account"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "USER, ACCOUNT"
        },
      predicate_binding_by_name["lb:web:credentials:database:public_key"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "USER, PUBLIC_KEY"
        }
    }.

    service_by_prefix["/tdx/users"] = x,
    delim_service(x) {
      delim_file_binding[] = "users"
    }.
  }),


  clauses(`{
    file_definition_by_name["jobs"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "ID,     USER,   JOBIMPL, OUTPUT_PREFIX, CLIENTID, OUTPUT_ENCRYPTION_KEY, CPU_USAGE, MAX_MEMORY",
      column_formats[] = "string, string, string,  string*,       string,   string,                int,       int",
      file_columns_can_be_absent[] = "OUTPUT_ENCRYPTION_KEY, CPU_USAGE, MAX_MEMORY"
    }.

    file_binding_by_name["jobs"] = fb,
    file_binding(fb) {
      file_binding_definition_name[] = "jobs",
      predicate_binding_by_name["lb:steve:schema:Job"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID"
        },
      predicate_binding_by_name["lb:steve:schema:Job:impl"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, JOBIMPL"
        },
      predicate_binding_by_name["lb:steve:schema:Job:output_prefix"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, OUTPUT_PREFIX"
        },
      predicate_binding_by_name["lb:steve:schema:Job:client_id"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, CLIENTID"
        },
      predicate_binding_by_name["lb:steve:schema:Job:user"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, USER"
        },
      predicate_binding_by_name["lb:steve:schema:Job:output_encryption_key"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, OUTPUT_ENCRYPTION_KEY"
        },
      predicate_binding_by_name["lb:steve:schema:Job:cpu_usage"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, CPU_USAGE"
        },
      predicate_binding_by_name["lb:steve:schema:Job:max_memory"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, MAX_MEMORY"
        }
    }.

    service_by_prefix["/tdx/jobs"] = x,
    delim_service(x) {
      delim_file_binding[] = "jobs"
    }.
  }),

  clauses(`{
    file_definition_by_name["job_metadata"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "ID,     KEY,    VALUE",
      column_formats[] = "string, string, string"
    }.

    file_binding_by_name["job_metadata"] = fb,
    file_binding(fb) {
      file_binding_definition_name[] = "job_metadata",
      predicate_binding_by_name["lb:steve:schema:Job:metadata"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, KEY, VALUE"
        }
    }.

    service_by_prefix["/tdx/job_metadata"] = x,
    delim_service(x) {
      delim_file_binding[] = "job_metadata"
    }.
  }),

  clauses(`{
    file_definition_by_name["job_inputs"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "ID,     INPUT,  HASH",
      column_formats[] = "string, string, string",
      file_columns_can_be_absent[] = "HASH"
    }.

    file_binding_by_name["job_inputs"] = fb,
    file_binding(fb) {
      file_binding_definition_name[] = "job_inputs",
      predicate_binding_by_name["lb:steve:schema:Job:input"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, INPUT"
        },
      predicate_binding_by_name["lb:steve:schema:Job:input_hash"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, INPUT, HASH"
        }
    }.

    service_by_prefix["/tdx/job_inputs"] = x,
    delim_service(x) {
      delim_file_binding[] = "job_inputs"
    }.
  }),

  clauses(`{
    file_definition_by_name["job_outputs"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "ID,     OUTPUT, HASH",
      column_formats[] = "string, string, string"
    }.

    file_binding_by_name["job_outputs"] = fb,
    file_binding(fb) {
      file_binding_definition_name[] = "job_outputs",
      predicate_binding_by_name["lb:steve:schema:Job:output_hash"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, OUTPUT, HASH"
        }
    }.

    service_by_prefix["/tdx/job_outputs"] = x,
    delim_service(x) {
      delim_file_binding[] = "job_outputs"
    }.
  }),

  clauses(`{
    file_definition_by_name["job_status"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "ID,     TIMESTAMP, EVENT,  MACHINE, MESSAGE",
      column_formats[] = "string, int,       string, string,  string*"
    }.

    file_binding_by_name["job_status"] = fb,
    file_binding(fb) {
      file_binding_definition_name[] = "job_status",
      predicate_binding_by_name["lb:steve:schema:Job:status_event"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, TIMESTAMP, EVENT"
        },
      predicate_binding_by_name["lb:steve:schema:Job:status_machine"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, TIMESTAMP, MACHINE"
        },
      predicate_binding_by_name["lb:steve:schema:Job:status_message"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "ID, TIMESTAMP, MESSAGE"
        }
    }.

    service_by_prefix["/tdx/job_status"] = x,
    delim_service(x) {
      delim_file_binding[] = "job_status"
    }.
  }),


  clauses(`{
    file_definition_by_name["jobimpls"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "IMPLID, ID,     USER,   ARCHIVE, ARCHIVE_HASH",
      column_formats[] = "string, string, string, string*,  string",
      file_columns_can_be_absent[] = "ARCHIVE_HASH"
    }.

    file_binding_by_name["jobimpls"] = fb,
    file_binding(fb) {
      file_binding_definition_name[] = "jobimpls",

      predicate_binding_by_name["lb:steve:schema:JobImpl"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "IMPLID"
        },
      predicate_binding_by_name["lb:steve:schema:JobImpl:id"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "IMPLID, ID"
        },
      predicate_binding_by_name["lb:steve:schema:JobImpl:archive"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "IMPLID, ARCHIVE"
        },
      predicate_binding_by_name["lb:steve:schema:JobImpl:archive_hash"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "IMPLID, ARCHIVE_HASH"
        },
      predicate_binding_by_name["lb:steve:schema:JobImpl:user"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "IMPLID, USER"
        }
    }.

    service_by_prefix["/tdx/jobimpls"] = x,
    delim_service(x) {
      delim_file_binding[] = "jobimpls"
    }.

  }),

  clauses(`{
    file_definition_by_name["jobimpl_metadata"] = fd,
    file_definition(fd) {
      file_delimiter[] = "|",
      column_headers[] = "IMPLID, ID,     KEY,    VALUE",
      column_formats[] = "string, string, string, string"
    }.

    file_binding_by_name["jobimpl_metadata"] = fb,
    file_binding(fb) {
      predicate_binding_by_name["lb:steve:schema:JobImpl:id"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "IMPLID, ID"
        },
      file_binding_definition_name[] = "jobimpl_metadata",
      predicate_binding_by_name["lb:steve:schema:JobImpl:metadata"] =
        predicate_binding(_) {
          predicate_binding_columns[] = "IMPLID, KEY, VALUE"
        }
    }.

    service_by_prefix["/tdx/jobimpl_metadata"] = x,
    delim_service(x) {
      delim_file_binding[] = "jobimpl_metadata"
    }.
  })

} <-- . 
