#!/usr/bin/env python

import sys
import os

bindir = os.path.dirname(os.path.realpath(__file__))
prefix = os.path.dirname(bindir)
sys.path.insert(0, '%s/lib/python' % prefix)

import argparse

def run(args):
    jetty_version = '7.6.7.v20120910'

    prefix_deps = [
      'lb-common.jar',
      'lb-web-client.jar',
      'lb-steve-client.jar',
      'lb-steve-protocols.jar',
      'jetty-client-' + jetty_version + '.jar',
      'jetty-http-' + jetty_version + '.jar',
      'jetty-io-' + jetty_version + '.jar',
      'jetty-util-' + jetty_version + '.jar',
    ]

    deps_paths = [prefix + '/lib/java/' + name for name in prefix_deps]
    classpath = ':'.join(deps_paths)

    jvm_args = []
    java_args = ['java'] + jvm_args + ['-cp', classpath, 'com.logicblox.steve.client.Main']
    java_args.extend(args)

    os.execvp('java', java_args)

def main():
    command_line = sys.argv[1:]
    run(command_line)

if __name__ == '__main__':
    main()

