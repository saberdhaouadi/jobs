#! /usr/bin/env bash
set -e

function send_job() 
{
  job=$1
  echo "sending job $job"
  jobid=$(uuidgen)

  aws sqs send-message --queue-url https://sqs.us-east-1.amazonaws.com/297794765570/steve-jobs --message-body "$(cat <<EOF
{ "job": "$jobid",
  "job_impl": "29167199-978b-408d-8abc-e3f1bcf4219a",
  "input": [ { "url": ["s3://steve-jobs/data/crate/mdo/20140424/$job/sku", "s3://steve-jobs/data/crate/mdo/20140424/to_mdo_engine_2014_04_24_1.tgz"] } ],
  "output": "s3://steve-jobs/jobs/$jobid/out"
}
EOF
)"
echo "$job,$jobid" >> sent
}

export -f send_job
cat jobs | parallel -j 20 send_job

