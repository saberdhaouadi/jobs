#! /usr/bin/env bash
set -e

function send_job() 
{
  job=$1
  echo "sending job $job"
  jobid=$(uuidgen)

  aws sqs send-message --queue-url https://sqs.us-east-1.amazonaws.com/297794765570/steve-jobs --message-body "$(cat <<EOF
{ "job": "$jobid",
  "job_impl": "f87e0ced-44f8-4d56-bf83-325da2bdef91",
  "input": ["s3://steve-jobs/data/crate/mdo/20140321/$job/data_input/", "s3://steve-jobs/data/crate/mdo/20140321/common_input/"],
  "output": "s3://steve-jobs/jobs/$jobid/out"
}
EOF
)"
}

export -f send_job
cat jobs | parallel -j 20 send_job

